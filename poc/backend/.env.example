# --- Server & Port (1 Port duy nhất cho cả Next.js UI + FastAPI + WS + MJPEG) ---
APP_NAME="ATIN Tran Han AI Backend"
ENVIRONMENT=poc
DEBUG=true
PORT=28080
API_V1_PREFIX=/api/v1
PROJECT_DISPLAY_NAME="Nhà máy Thủy sản Trần Hân"
SERVE_FRONTEND=true

# --- Paths (relative to poc/backend/ or absolute) ---
FRONTEND_DIR=../frontend/out
FRONTEND_LEGACY_DIR=../frontend
CAMERAS_FILE=../data/cameras.json
MODEL_PATH=../models/yolo26s_best.onnx
STORAGES_DIR=../storages

# --- Security & CORS ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:28080","http://127.0.0.1:28080","http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=600

# --- NVR Nhà máy Thủy sản Trần Hân (DDNS Direct Mode) ---
NVR_HOST=nmts2025.smartddns.tv
NVR_PORT=80
NVR_USER=user
NVR_PASS=testcam@123
NVR_STREAM_FPS_LIMIT=12.0

# --- AI Core (ONNX Runtime CUDA FP16 + ByteTrack + Zone Presence Rule Engine) ---
AI_ENABLED=true
AI_RUNTIME=auto
AI_VRAM_LIMIT_MB=1024
AI_CONF_THRESHOLD=0.40
AI_IMGSZ=640
AI_TARGET_FPS=12.0
AI_ANCHOR_MODE=bottom_center
AI_PRESENCE_GRACE_SECONDS=2.0
AI_PRESENCE_WARNING_SECONDS=10.0
AI_TIMELINE_WINDOW_SECONDS=1800
AI_INTERVAL_SEC=0.5
AI_FOCUS_INTERVAL_SEC=0.15
AI_FOCUS_TTL_SEC=15.0
AI_CONFIRM_SECONDS=2.0
AI_EVENT_COOLDOWN_SECONDS=60.0
WS_PUSH_MAX_HZ=15.0

# --- Database (Production / Alembic) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tranhan_ai

# --- ATIN Smart VMS Integration (Production Edge / Service Mode) ---
ATIN_VMS_ENABLED=false
MQTT_HOST=aioc-stg.atin.vn
MQTT_PORT=443
MQTT_WS_PATH=/mqtt
MQTT_USER=atin
MQTT_PASS=change-me
MQTT_CLIENT_ID=ai_edge_tranhan_01
MQTT_KEEPALIVE=30
ORGANIZATION_ID=103
ZONE_ID=51
AI_MODULE_CODE=ZONE
STORAGE_UPLOAD_URL=https://aioc-stg.atin.vn/storage/upload/file
STORAGE_CATEGORY=zone
BBOX_PUBLISH_INTERVAL=0.2
